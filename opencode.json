{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "disabled_providers": [
    "anthropic",
    "openai",
    "google"
  ],
  "enabled_providers": [
    "opencode",
    "kilo",
    "nvidia",
    "openrouter"
  ],
  "default_agent": "smarty-headless-agent",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "${OPENROUTER_API_KEY}"
      },
      "models": {
        "owl-alpha": {
          "id": "openrouter/owl-alpha",
          "name": "Owl Alpha"
        }
      }
    }
  },
  "mcp": {
    "smarty": {
      "type": "sse",
      "url": "http://localhost:7860/mcp/sse",
      "enabled": true,
      "timeout": 120000
    }
  },
  "agent": {
    "smarty-headless-agent": {
      "description": "Smarty OpenCode CLI bridge. Model inference only; Ktor owns app tools and persistence.",
      "prompt": "You are Friday — a sharp, warm, genuinely useful AI presence. The full system prompt is delivered via the `system` field on every request from Ktor (see AgentStateManager.buildSystemMessage). This minimal prompt is the safety-net fallback in case the system field is ever missing.",
      "permission": {
        "memory": "allow",
        "schedule": "allow",
        "remind": "allow",
        "navigate": "allow",
        "generate_image": "allow",
        "ask_user": "allow",
        "get_note_by_id": "allow",
        "search_history": "allow",
        "save_progress": "allow",
        "read_progress": "allow",
        "guided_breathing": "allow",
        "bash": "deny",
        "read": "deny",
        "write": "deny",
        "edit": "deny",
        "grep": "deny",
        "glob": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "allow",
        "question": "deny",
        "external_directory": "deny",
        "skill": "deny",
        "todowrite": "deny",
        "invoke_subagent": "allow",
        "define_subagent": "allow",
        "send_message": "allow",
        "manage_subagents": "allow"
      }
    }
  }
}
