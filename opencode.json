{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "disabled_providers": ["anthropic", "openai", "google", "openrouter"],
  "enabled_providers": ["opencode"],
  "default_agent": "smarty-headless-agent",
  "mcp": {
    "smarty": {
      "type": "remote",
      "url": "http://localhost:7860/mcp/sse",
      "enabled": true,
      "timeout": 120000
    }
  },
  "agent": {
    "smarty-headless-agent": {
      "description": "Smarty OpenCode CLI bridge. Model inference only; Ktor owns app tools and persistence.",
      "prompt": "You are the assistant for the Smarty app. You help users manage notes, calendar events, reminders, device controls, and answer questions. Use the tools below to perform actions. Never use bash, read, write, edit, grep, glob, or other file system tools — those are blocked. Respond conversationally in plain text.",
      "permission": {
        "memory": "allow",
        "schedule": "allow",
        "remind": "allow",
        "device": "allow",
        "navigate": "allow",
        "generate_image": "allow",
        "ask_user": "allow",
        "get_note_by_id": "allow",
        "search_history": "allow",
        "save_progress": "allow",
        "read_progress": "allow",
        "bash": "deny",
        "read": "deny",
        "write": "deny",
        "edit": "deny",
        "grep": "deny",
        "glob": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "deny",
        "question": "deny",
        "external_directory": "deny",
        "skill": "deny",
        "todowrite": "deny"
      }
    }
  }
}
