        android:fillColor="#EEEEEE"
        android:pathData="M44,62 L38,54 Q36,51 38,49 Q40,47 43,49 L48,55 L48,62 Z" />

    <!-- Index finger (pointing up) -->
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M46,58 L46,38 Q46,34 49,34 Q52,34 52,38 L52,58 Z" />

    <!-- Middle finger (folded - small bump) -->
    <path
        android:fillColor="#E8E8E8"
        android:pathData="M52,58 L52,52 Q54,50 56,52 L56,58 Z" />

    <!-- Ring finger (folded - small bump) -->
    <path
        android:fillColor="#E8E8E8"
        android:pathData="M56,58 L56,54 Q58,52 60,54 L60,58 Z" />

    <!-- Pinky finger (pointing up) -->
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M60,58 L60,42 Q60,38 63,38 Q66,38 66,42 L66,58 Z" />

    <!-- Subtle shadow under palm -->
    <path
        android:fillColor="#00000022"
        android:pathData="M46,76 Q54,80 62,76 L62,78 Q54,82 46,78 Z" />

</vector>
