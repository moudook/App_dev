    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Blue glow effect behind hand -->
    <path android:pathData="M54,75 m-25,0 a25,20 0 1,0 50,0 a25,20 0 1,0 -50,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="70"
                android:gradientRadius="30"
                android:type="radial">
                <item android:color="#660066FF" android:offset="0.0" />
                <item android:color="#330066FF" android:offset="0.5" />
                <item android:color="#000066FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hand - Palm base -->
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M44,58 L44,72 Q44,76 48,76 L60,76 Q64,76 64,72 L64,58 Q64,55 54,55 Q44,55 44,58 Z" />

    <!-- Thumb (pointing left-up) -->
