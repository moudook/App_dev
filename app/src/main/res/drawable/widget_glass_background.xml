<?xml version="1.0" encoding="utf-8"?>
<!-- Simplified glassmorphism background for widget compatibility -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#E81C1C1E"
        android:endColor="#F0181818"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1.5dp"
        android:color="#402979FF" />
</shape>
